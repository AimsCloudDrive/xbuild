{
  "name": "@msom/xbuild",
  "version": "1.0.0",
  "type": "module",
  "description": "High-performance build tool powered by Rolldown",
  "main": "./dist/cli.js",
  "bin": {
    "xbuild": "./bin/xbuild.js"
  },
  "scripts": {
    "build:cli": "rolldown -c rolldown.config.mjs && cp dist/cli.js bin/xbuild.js && chmod +x bin/xbuild.js",
    "dev": "xbuild dev",
    "build": "xbuild build",
    "check": "xbuild check",
    "compile": "xbuild compile",
    "vite:build": "vite build"
  },
  "files": [
    "dist",
    "bin"
  ],
  "keywords": [
    "bundler",
    "rolldown",
    "build-tool"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "rolldown": "^1.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.21.0",
    "vite": "^8.0.11",
    "vite-plugin-dts": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm"
}
